{
  "name": "scope-recall-openclaw",
  "version": "1.1.0",
  "description": "Scoped long-term memory for OpenClaw with SQLite truth, hybrid recall, rebuildable vectors, safe capture, and native-free fallbacks",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "DESIGN.md",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "benchmarks/",
    "cli.ts",
    "dist/",
    "docs/",
    "index.ts",
    "openclaw.plugin.json",
    "package.json",
    "scripts/",
    "src/",
    "tests/",
    "tsconfig.build.json",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "smoke:clawlore-address-v2": "node scripts/clawlore-memory-address-v2-smoke.mjs",
    "smoke:clawlore-context-pack-v1": "node scripts/clawlore-context-pack-v1-smoke.mjs",
    "smoke:clawlore-legacy-shadow": "node scripts/clawlore-legacy-shadow-smoke.mjs",
    "smoke:clawlore-legacy-distillation": "node --test tests/clawlore-legacy-distillation-triggers.test.mjs",
    "smoke:clawlore-security-hardening": "node scripts/clawlore-security-hardening-smoke.mjs",
    "smoke:clawlore-runtime-shadow": "node --test tests/clawlore-runtime-shadow.test.mjs",
    "smoke:clawlore-truth-v2": "node --test tests/clawlore-truth-v2.test.mjs",
    "smoke:clawlore-distillation": "node --test tests/clawlore-distillation-projection.test.mjs",
    "smoke:clawlore-projection-convergence": "node --test tests/clawlore-projection-convergence.test.mjs",
    "smoke:clawlore-runtime-facade": "node --test tests/clawlore-agent-facade-context-engine.test.mjs",
    "smoke:clawlore-module-boundaries": "node --test tests/clawlore-module-boundaries.test.mjs",
    "smoke:clawlore-memory-center": "node --test tests/clawlore-memory-center.test.mjs",
    "smoke:clawlore-subagent-experience": "node --test tests/clawlore-subagent-experience.test.mjs",
    "smoke:clawlore-release-readiness": "node --test tests/clawlore-release-readiness.test.mjs",
    "smoke:clawlore-runtime-composition": "node scripts/clawlore-runtime-composition-smoke.mjs",
    "audit:clawlore-shadow-observation": "node scripts/clawlore-shadow-observation-audit.mjs",
    "preflight:clawlore-live-migration": "node scripts/clawlore-legacy-live-preflight.mjs",
    "snapshot:clawlore-encrypted-live": "node scripts/clawlore-encrypted-live-snapshot.mjs",
    "rollout:clawlore-live-v2-write": "node scripts/clawlore-live-v2-write-rollout.mjs",
    "eval:clawlore-live-recall-parity": "node scripts/clawlore-live-recall-parity.mjs",
    "smoke:clawlore-ranking-promotion": "node scripts/clawlore-ranking-promotion-smoke.mjs",
    "smoke:clawlore-phase7g-controls": "node scripts/clawlore-phase7g-rollout-controls-smoke.mjs",
    "preview:clawlore-phase7g-live": "node scripts/clawlore-phase7g-live-preview.mjs",
    "preview:clawlore-candidate-evidence": "node scripts/clawlore-candidate-evidence-remediation.mjs",
    "preview:clawlore-source-lineage": "node scripts/clawlore-source-lineage-receipt-plan.mjs",
    "preview:clawlore-evidence-assignment": "node scripts/clawlore-evidence-assignment-plan.mjs",
    "preview:clawlore-post-assignment-candidates": "node scripts/clawlore-post-assignment-candidate-plan.mjs",
    "preview:clawlore-v1-append-delta": "node scripts/clawlore-v1-append-delta-plan.mjs",
    "rollout:clawlore-v1-append-delta": "node scripts/clawlore-live-v1-append-delta.mjs",
    "rollout:clawlore-evidence-assignment": "node scripts/clawlore-live-evidence-assignment.mjs",
    "rollout:clawlore-live-compatibility": "node scripts/clawlore-live-compatibility-backfill.mjs",
    "smoke:clawlore-snapshot": "node --test tests/clawlore-snapshot-restore.test.mjs",
    "smoke:clawlore-legacy-live-preflight": "node --test tests/clawlore-legacy-live-preflight.test.mjs",
    "smoke:clawlore-encrypted-snapshot": "node --test tests/clawlore-encrypted-snapshot-archive.test.mjs",
    "smoke:clawlore-encrypted-legacy-snapshot": "node --test tests/clawlore-encrypted-legacy-snapshot.test.mjs",
    "smoke:clawlore-migration-drill": "node --test tests/clawlore-legacy-migration-drill.test.mjs",
    "smoke:vector-repair": "node scripts/smoke-vector-repair.mjs",
    "release:gate": "SCOPE_RECALL_ALLOW_NESTED_GIT_ROOT=1 node scripts/release-gate.mjs"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "memory",
    "scope-recall",
    "sql-truth",
    "lancedb",
    "vector-search",
    "bm25",
    "hybrid-retrieval",
    "rerank",
    "ai-memory",
    "long-term-memory",
    "chunking",
    "long-context"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/410979729/scope-recall-openclaw.git"
  },
  "bugs": {
    "url": "https://github.com/410979729/scope-recall-openclaw/issues"
  },
  "homepage": "https://github.com/410979729/scope-recall-openclaw#readme",
  "author": "win4r",
  "license": "MIT",
  "dependencies": {
    "@lancedb/lancedb": "^0.26.2",
    "@sinclair/typebox": "0.34.48",
    "apache-arrow": "18.1.0",
    "json5": "^2.2.3",
    "openai": "^6.21.0",
    "proper-lockfile": "^4.1.2"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "install": {
      "npmSpec": "scope-recall-openclaw",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.6.2"
    },
    "compat": {
      "pluginApi": ">=2026.6.2",
      "minGatewayVersion": "2026.6.2"
    },
    "build": {
      "openclawVersion": "2026.6.2",
      "pluginSdkVersion": "2026.6.2"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true,
      "bundleRuntimeDependencies": false
    }
  },
  "devDependencies": {
    "jiti": "^2.7.0",
    "typescript": "^6.0.3"
  }
}
